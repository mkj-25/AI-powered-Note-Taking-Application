# ──────────────────────────────────────────────────────────────────
# NOTRA — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file.
# ──────────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URL=

# JWT secret — use a long, random string in production
JWT_SECRET=

# Google Gemini API key (https://aistudio.google.com/app/apikey)
# If omitted, Notra runs in demo mode with pre-defined AI responses.
GEMINI_API_KEY=

# OpenAI API key — optional.
# Used for: Whisper voice-to-text transcription + text-embedding-3-small semantic search.
# If omitted, a lightweight built-in embedding fallback is used and voice features show a demo message.
OPENAI_API_KEY=

# Server port (default: 5000)
PORT=5000

# Environment
NODE_ENV=development

# Allowed client origin (for CORS)
CLIENT_URL=http://localhost:5173
